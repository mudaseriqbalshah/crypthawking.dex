# ---------------------------------------------------------------------------
# CryptoHawking (Base Sepolia fork) — REQUIRED LOCAL DEV VALUES
#
# `.env` and `.env.development` are gitignored, so this block is the tracked
# source of truth. Copy it into `apps/web/apps/web/.env.development` before
# running `pnpm dev`, or spec §6.9 (zero requests to *.pancakeswap.* hosts)
# will fail: every one of these defaults to a PancakeSwap-operated backend when
# left unset. Empty = the feature is disabled and no request is made.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ASSET_CDN=""            # was https://assets.pancakeswap.finance
NEXT_PUBLIC_TOKEN_IMAGE_CDN=""      # was https://tokens.pancakeswap.finance
NEXT_PUBLIC_PROOF_API=""            # was https://proofs.pancakeswap.com (CMS configs)
NEXT_PUBLIC_QUOTING_API=""          # was https://x.pancakeswap.com
NEXT_PUBLIC_MM_API_URL=""           # was https://linked-pool.pancakeswap.com/quote-service
NEXT_PUBLIC_MERKL_API=""            # Merkl campaigns are pancake-swap-scoped; we have none
NEXT_PUBLIC_BRIDGE_API=""
NEXT_PUBLIC_GIFT_API=""
NEXT_PUBLIC_SNAPSHOT_BASE_URL=""
NEXT_PUBLIC_GTAG=""
MOONPAY_API=""
# RISKS.md 2026-08-05: these two are still upstream PancakeSwap's. Blanking them
# makes @privy-io hard-throw and the app 500s (usePrivy is consumed unconditionally).
NEXT_PUBLIC_PRIVY_APP_ID=cm9jd1prg03msl80mz1jnuv9f
NEXT_PUBLIC_PRIVY_CLIENT_ID=client-WY5iumRXNUjYdviuz7nf3m3z3atS4iHaRMWLTekR5Qpjp
