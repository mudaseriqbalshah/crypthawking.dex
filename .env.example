# Copy to .env — NEVER commit .env. Testnet-only values; no mainnet keys, ever.
RPC_URL=https://sepolia.base.org
# Optional fallback RPC with an API key (Alchemy/QuickNode), still Base Sepolia:
RPC_URL_FALLBACK=
# Fresh, testnet-only deployer key (fund via a Base Sepolia faucet):
DEPLOYER_PRIVATE_KEY=
# Free Etherscan/Basescan API key for contract verification:
ETHERSCAN_API_KEY=
# Frontend (apps/web): Base Sepolia RPC used as the primary node (falls back to the
# public https://sepolia.base.org if unset). Public RPC nonce races are a known
# RISKS.md item — prefer a keyed RPC (Alchemy/QuickNode) here for the frontend too.
NEXT_PUBLIC_BASE_SEPOLIA_RPC=
